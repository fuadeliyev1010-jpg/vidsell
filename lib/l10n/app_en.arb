  "aboutWhatTitle": "What is Vidsell?",
  "aboutWhatBody": "Vidsell is a marketplace platform that lets users create listings, search for products, and contact sellers.",
  "aboutFeaturesTitle": "Key features",
  "aboutFeaturesBody": "Discover listings by category, search and filter, save listings, and message sellers.",
  "aboutVersionTitle": "Version",
  "aboutVersionBody": "This version of the app uses mock data sources in preparation for backend integration. Data storage and account synchronization will be enabled when the backend is connected.",
  "privacyDataCollectedTitle": "Data we collect",
  "privacyDataCollectedBody": "An account uses your phone number, name, and, when required, email address. Listing, message, saved-item, and followed-store data may be associated with your account.",
  "privacyDataUseTitle": "How we use your data",
  "privacyDataUseBody": "Data is used to manage your account, display listings, provide messaging, maintain security, and deliver support services.",
  "privacyRetentionTitle": "Data retention and security",
  "privacyRetentionBody": "Access to data should be limited according to account permissions. During real backend integration, retention periods, deletion requests, and security measures will be defined in the backend policy.",
  "privacyRightsTitle": "Your rights",
  "privacyRightsBody": "You can update your profile and contact support with questions about deleting account data or handling personal information.",
  "agreementUseTitle": "Use of the service",
  "agreementUseBody": "Only lawful and truthful listings that do not violate others' rights may be posted on Vidsell. You are responsible for keeping your account information confidential.",
  "agreementListingsTitle": "Listings and transactions",
  "agreementListingsBody": "The seller is responsible for a listing's content, price, photos, and contact details. Vidsell may moderate listings and restrict content that does not follow the rules.",
  "agreementMessagesTitle": "Messaging",
  "agreementMessagesBody": "Abuse, spam, fraud, and misuse of personal information are prohibited in messages. Report suspicious activity to support.",
  "agreementRestrictionsTitle": "Account restrictions",
  "agreementRestrictionsBody": "Accounts and listings may be restricted temporarily or permanently if the rules are violated. You can contact support about a decision.",
  "offerPartiesTitle": "Parties to the agreement",
  "offerPartiesBody": "This offer sets out the terms for using Vidsell services and the main conditions between the user and the platform.",
  "offerPlatformRoleTitle": "The platform's role",
  "offerPlatformRoleBody": "Vidsell provides listing, search, contact, and account services. The buyer and seller are responsible for their product and payment arrangements.",
  "offerPaidServicesTitle": "Paid services",
  "offerPaidServicesBody": "Paid services are provided at the prices and under the terms shown in the app. Payment confirmation and refunds will follow the rules of the production payment provider and backend.",
  "offerChangesTitle": "Changes",
  "offerChangesBody": "These terms may be updated when the service or laws change. Updated terms take effect when published in the app.",
  "rulesProhibitedTitle": "Prohibited listings",
  "rulesProhibitedBody": "Listings for illegal products, counterfeit goods, weapons, drugs, stolen items, and products dangerous to human health are prohibited.",
  "rulesQualityTitle": "Listing quality",
  "rulesQualityBody": "The title, description, price, and photos must accurately represent the product. Duplicate listings, misleading prices, and spam are not accepted.",
  "rulesCommunicationTitle": "Communication",
  "rulesCommunicationBody": "Treat other users respectfully. Report abuse, threats, spam, attempted fraud, or requests for risky off-platform payments.",
  "rulesComplaintsTitle": "Reporting",
  "rulesComplaintsBody": "Use the listing or user report feature when you see a rule violation. In urgent safety situations, contact local law enforcement.",
